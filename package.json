{
  "name": "acompanhe-seu-candidato",
  "version": "0.1.0",
  "private": true,
  "description": "Web app público e gratuito: a colinha de 2026 vira o jeito de acompanhar deputados federais e senadores.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "votacoes": "npm run votacoes -w @acompanhe/pipeline --",
    "spike:noticias": "npm run spike:noticias -w @acompanhe/pipeline --",
    "migrar": "npm run migrar -w @acompanhe/pipeline --",
    "gravar": "npm run gravar -w @acompanhe/pipeline --",
    "candidatos": "npm run candidatos -w @acompanhe/pipeline --"
  }
}
